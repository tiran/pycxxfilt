# SPDX-License-Identifier: Apache-2.0
# Build system
include pyproject.toml
include meson.build
include tox.ini
include MANIFEST.in

# Documentation
include *.md

# License
include LICENSE*

# Extension source
recursive-include src *.py *.pyi *.cpp *.build

# Vendored LLVM demangler (llvmorg-22.1.3)
include vendor/LLVM_TAG
include vendor/cxa_demangle.cpp
include vendor/abort_message.h
include vendor/__cxxabi_config.h
recursive-include vendor/demangle *.h *.def *.txt

# Test data
include vendor/DemangleTestCases.inc

# Tests
recursive-include tests *.py
